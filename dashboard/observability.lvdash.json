{
  "datasets": [
    {
      "name": "flow_progress_by_table",
      "displayName": "Flow Progress by Table",
      "queryLines": [
        "SELECT\n",
        "  origin.flow_name AS tabla,\n",
        "  CAST(\n",
        "    get_json_object(details, '$.flow_progress.metrics.num_output_rows') AS DOUBLE\n",
        "  ) AS registros_procesados,\n",
        "  timestamp\n",
        "FROM\n",
        "  finpay_event_log_prod\n",
        "WHERE\n",
        "  event_type = 'flow_progress'\n",
        "  AND origin.flow_name IS NOT NULL\n",
        "  AND CAST(\n",
        "    get_json_object(details, '$.flow_progress.metrics.num_output_rows') AS DOUBLE\n",
        "  ) IS NOT NULL"
      ],
      "columns": [
        {
          "displayName": "tabla_corta",
          "description": "Último segmento del nombre de tabla después del último punto",
          "expression": "SUBSTRING_INDEX(`tabla`, '.', -1)"
        }
      ],
      "catalog": "fintech_finpay",
      "schema": "observability"
    },
    {
      "name": "failed_quality_by_rule",
      "displayName": "Registros fallidos por regla de calidad",
      "config": {
        "version": "1.1",
        "source": "WITH base AS (\n  SELECT\n    origin.flow_name AS flow_name,\n    timestamp,\n    from_json(\n      get_json_object(details, '$.flow_progress.data_quality.expectations'),\n      'array<struct<name:string,dataset:string,passed_records:bigint,failed_records:bigint>>'\n    ) AS expectations\n  FROM fintech_finpay.observability.finpay_event_log_prod\n  WHERE event_type = 'flow_progress'\n    AND origin.flow_name IS NOT NULL\n    AND get_json_object(details, '$.flow_progress.data_quality.expectations') IS NOT NULL\n), exploded AS (\n  SELECT\n    flow_name,\n    timestamp,\n    expectation.name AS expectation_name,\n    expectation.failed_records AS failed_records\n  FROM base\n  LATERAL VIEW explode(expectations) e AS expectation\n) SELECT * FROM exploded WHERE expectation_name IS NOT NULL\n  AND failed_records > 0\n",
        "dimensions": [
          {
            "name": "flow_name",
            "expr": "flow_name"
          },
          {
            "name": "expectation_name",
            "expr": "expectation_name"
          },
          {
            "name": "timestamp",
            "expr": "timestamp"
          }
        ],
        "measures": [
          {
            "name": "failed_records_total",
            "expr": "SUM(failed_records)",
            "displayName": "Registros fallidos"
          }
        ]
      }
    },
    {
      "name": "top5_daily_processed_vs_failed",
      "displayName": "Top 5 flows - tendencia diaria",
      "config": {
        "version": "1.1",
        "source": "WITH processed_rank AS (\n  SELECT\n    origin.flow_name AS flow_name,\n    SUM(CAST(get_json_object(details, '$.flow_progress.metrics.num_output_rows') AS DOUBLE)) AS total_procesados\n  FROM fintech_finpay.observability.finpay_event_log_prod\n  WHERE event_type = 'flow_progress'\n    AND origin.flow_name IS NOT NULL\n    AND CAST(get_json_object(details, '$.flow_progress.metrics.num_output_rows') AS DOUBLE) IS NOT NULL\n  GROUP BY origin.flow_name\n), top5 AS (\n  SELECT flow_name\n  FROM (\n    SELECT\n      flow_name,\n      ROW_NUMBER() OVER (ORDER BY total_procesados DESC) AS rn\n    FROM processed_rank\n  ) ranked\n  WHERE rn <= 5\n), processed AS (\n  SELECT\n    DATE_TRUNC('DAY', timestamp) AS fecha,\n    DATE_TRUNC('DAY', timestamp) AS timestamp,\n    origin.flow_name AS flow_name,\n    'Registros procesados' AS metrica,\n    SUM(CAST(get_json_object(details, '$.flow_progress.metrics.num_output_rows') AS DOUBLE)) AS valor\n  FROM fintech_finpay.observability.finpay_event_log_prod\n  WHERE event_type = 'flow_progress'\n    AND origin.flow_name IN (SELECT flow_name FROM top5)\n    AND CAST(get_json_object(details, '$.flow_progress.metrics.num_output_rows') AS DOUBLE) IS NOT NULL\n  GROUP BY DATE_TRUNC('DAY', timestamp), origin.flow_name\n), failed AS (\n  SELECT\n    DATE_TRUNC('DAY', timestamp) AS fecha,\n    DATE_TRUNC('DAY', timestamp) AS timestamp,\n    flow_name,\n    'Registros fallidos' AS metrica,\n    SUM(failed_records) AS valor\n  FROM (\n    SELECT\n      base.timestamp,\n      base.flow_name,\n      expectation.failed_records AS failed_records,\n      expectation.name AS expectation_name\n    FROM (\n      SELECT\n        timestamp,\n        origin.flow_name AS flow_name,\n        from_json(\n          get_json_object(details, '$.flow_progress.data_quality.expectations'),\n          'array<struct<name:string,dataset:string,passed_records:bigint,failed_records:bigint>>'\n        ) AS expectations\n      FROM fintech_finpay.observability.finpay_event_log_prod\n      WHERE event_type = 'flow_progress'\n        AND origin.flow_name IN (SELECT flow_name FROM top5)\n        AND get_json_object(details, '$.flow_progress.data_quality.expectations') IS NOT NULL\n    ) base\n    LATERAL VIEW explode(expectations) e AS expectation\n  ) q\n  WHERE expectation_name IS NOT NULL\n    AND failed_records > 0\n  GROUP BY DATE_TRUNC('DAY', timestamp), flow_name\n) SELECT fecha, timestamp, flow_name, metrica, valor FROM processed UNION ALL SELECT fecha, timestamp, flow_name, metrica, valor FROM failed\n",
        "dimensions": [
          {
            "name": "timestamp",
            "expr": "timestamp",
            "displayName": "Fecha"
          },
          {
            "name": "fecha",
            "expr": "fecha",
            "displayName": "Fecha"
          },
          {
            "name": "flow_name",
            "expr": "flow_name",
            "displayName": "Flow"
          },
          {
            "name": "metrica",
            "expr": "metrica",
            "displayName": "Métrica"
          }
        ],
        "measures": [
          {
            "name": "valor_total",
            "expr": "SUM(valor)",
            "displayName": "Total"
          }
        ]
      }
    },
    {
      "name": "channel_reverse_rate",
      "displayName": "Tasa de reversa por canal",
      "config": {
        "version": "1.1",
        "source": "fintech_finpay.default.channel_summary",
        "dimensions": [
          {
            "name": "fecha",
            "expr": "fecha",
            "displayName": "Fecha"
          },
          {
            "name": "timestamp",
            "expr": "CAST(fecha AS TIMESTAMP)",
            "displayName": "Fecha"
          },
          {
            "name": "channel",
            "expr": "channel",
            "displayName": "Canal"
          }
        ],
        "measures": [
          {
            "name": "reverse_rate_avg",
            "expr": "AVG(tasa_reversa)",
            "displayName": "Tasa de reversa"
          }
        ]
      }
    }
  ],
